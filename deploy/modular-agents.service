# /etc/systemd/system/modular-agents.service
# Deployed variant for the personal/live worktree.
# Derived from the repo template (modular-agents.service) with paths
# substituted for /home/exedev/modular-agents-live.
[Unit]
Description=Modular Agents — Semi Autonomous AI Assistant
After=network-online.target
Wants=network-online.target
StartLimitInterval=120
StartLimitBurst=5

[Service]
Type=simple
# For maximum security, run as dedicated system user
# To create: sudo useradd -r -s /usr/sbin/nologin modular-agents
# Then change ownership: sudo chown -R modular-agents:modular-agents /home/exedev/modular-agents-live
# User=modular-agents
User=exedev
Group=exedev
WorkingDirectory=/home/exedev/modular-agents-live
Environment="PATH=/home/exedev/modular-agents-live/.venv/bin:/home/exedev/.local/bin:/home/exedev/.railway/bin:/usr/local/bin:/usr/bin"
Environment="HOME=/home/exedev"
ExecStart=/home/exedev/modular-agents-live/.venv/bin/python /home/exedev/modular-agents-live/main.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
# ProtectSystem=strict makes the filesystem read-only outside these paths.
# The app writes to:
#   memory/   sessions.db, scheduler.db, calendar.db, context/, solutions/
#   agents/   agents/wellbeing/state.json, and new agents created by /newagent
#   ~/.cache  faster-whisper model download (voice transcription)
#   ~/.config gh and railway CLI state (DevOps agent)
# A leading "-" skips a path that doesn't exist instead of failing the unit.
# Add any LOCAL_FILE_PATHS folders here too, or agent writes to them fail.
# Logs go to journald (StandardOutput/StandardError above), not to a file,
# so no log directory is needed here.
ReadWritePaths=/home/exedev/modular-agents-live/memory /home/exedev/modular-agents-live/agents
ReadWritePaths=-/home/exedev/.cache -/home/exedev/.config
# Adjust to your workload — headroom for a Python asyncio bot process.
MemoryMax=512M

[Install]
WantedBy=multi-user.target
